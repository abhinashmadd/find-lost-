# ==========================================
# Root Full-Stack Environment Variables
# ==========================================

# Execution mode: "development" | "production" | "test"
NODE_ENV=development

# Server HTTP Port
PORT=5000

# Database Connection (MongoDB Atlas connection string or "local" for standalone JSON persistence)
MONGODB_URI=local
USE_LOCAL_DB=true

# Security: JWT Secret (change in production)
JWT_SECRET=supersecretjwtkeyforcollegeproject2026
JWT_EXPIRES_IN=7d

# CORS Allowed Origin
CLIENT_URL=http://localhost:5173

# Cloudinary Storage (Optional fallback to local /uploads if demo/unconfigured)
CLOUDINARY_CLOUD_NAME=demo
CLOUDINARY_API_KEY=123456789
CLOUDINARY_API_SECRET=abcdef123456

# Upload Configuration
MAX_FILE_SIZE_MB=2

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_API_MAX=100
RATE_LIMIT_LOGIN_MAX=5

# Seed Administrator Account Credentials
ADMIN_NAME=System Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@1234

# Client Variables (Vite requires VITE_ prefix)
VITE_API_URL=http://localhost:5000/api
VITE_APP_NAME=Campus Lost and Found Portal
