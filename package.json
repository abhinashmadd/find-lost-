{
  "name": "lost-and-found-mern",
  "version": "1.0.0",
  "description": "Lost and Found Web Application - MERN Stack College Mini Project",
  "scripts": {
    "dev": "node node_modules/concurrently/dist/bin/concurrently.js -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "server": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "seed": "npm --prefix server run seed",
    "fix:users": "npm --prefix server run fix:users",
    "build:client": "npm --prefix client run build"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "author": "Ayush Chaturvedi",
  "license": "ISC"
}
