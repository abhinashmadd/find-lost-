# ==========================================
# Server Environment Configuration (.env)
# ==========================================

# Execution mode: "development" | "production" | "test"
NODE_ENV=development

# Server HTTP Port
PORT=5000

# MongoDB Connection String:
# - For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/lostandfound?retryWrites=true&w=majority
# - For Standalone Built-in Local DB (offline, no MongoDB installation needed): local
MONGODB_URI=local
USE_LOCAL_DB=true

# Security: JSON Web Token Secret & Expiration
# IMPORTANT: In production, generate a secure 64+ char random hex string
JWT_SECRET=supersecretjwtkeyforcollegeproject2026
JWT_EXPIRES_IN=7d

# Cross-Origin Resource Sharing (CORS): Frontend Origin URL
CLIENT_URL=http://localhost:5173

# Cloudinary Storage for Uploaded Photographs (Optional; falls back to local disk if omitted or left as demo)
CLOUDINARY_CLOUD_NAME=demo
CLOUDINARY_API_KEY=123456789
CLOUDINARY_API_SECRET=abcdef123456

# Upload Configuration
MAX_FILE_SIZE_MB=2

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_API_MAX=100
RATE_LIMIT_LOGIN_MAX=5

# Seed Administrator Account Credentials (Auto-created if absent)
ADMIN_NAME=System Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@1234
